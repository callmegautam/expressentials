{
  "name": "expressentials",
  "version": "0.0.3",
  "description": "Essential Express.js helpers — status codes, errors, logging, validation, and more",
  "keywords": [
    "express",
    "expressjs",
    "middleware",
    "http",
    "status",
    "errors",
    "logger",
    "validation",
    "request-id",
    "health-check"
  ],
  "homepage": "https://github.com/callmegautam/expressentials#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callmegautam/expressentials.git"
  },
  "bugs": {
    "url": "https://github.com/callmegautam/expressentials/issues"
  },
  "license": "MIT",
  "author": "Gautam Suthar (https://github.com/callmegautam)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.0.0",
    "prettier": "^3.9.4",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
